+    /// Connections that neither side uses any more must be closed.
+    ///
+    /// A small swarm keeps re-joining all known peers, so neighbors are evicted and
+    /// short-lived dials happen constantly. Once the joins stop, only connections
+    /// to neighbors may stay open.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+    async fn unused_connections_are_closed() -> n0_error::Result<()> {
+        const NODES: usize = 8;
+        let mut membership = HyparviewConfig::default();
+        membership.active_view_capacity = 3;
+        membership.passive_view_capacity = 8;
+        membership.shuffle_active_view_count = 2;
+
+        let lookup = MemoryLookup::new();
+        let mut routers = Vec::new();
+        let mut gossips = Vec::new();
+        for _ in 0..NODES {
+            let ep = Endpoint::empty_builder().bind().await?;
+            ep.address_lookup()?.add(lookup.clone());
+            let gossip = Gossip::builder()
+                .membership_config(membership.clone())
+                .spawn(ep.clone());
+            let router = Router::builder(ep)
+                .accept(crate::ALPN, gossip.clone())
+                .spawn();
+            lookup.add_endpoint_info(router.endpoint().addr());
+            routers.push(router);
+            gossips.push(gossip);
+        }
+        let ids: Vec<EndpointId> = routers.iter().map(|r| r.endpoint().id()).collect();
+        let topics = [TopicId::from([1u8; 32]), TopicId::from([2u8; 32])];
+
+        let mut senders = Vec::new();
+        for (index, gossip) in gossips.iter().enumerate() {
+            let others: Vec<EndpointId> =
+                ids.iter().copied().filter(|id| *id != ids[index]).collect();
+            for topic in topics {
+                let (sender, mut receiver) = gossip.subscribe(topic, others.clone()).await?.split();
+                spawn(async move { while receiver.next().await.is_some() {} });
+                senders.push((sender, others.clone()));
+            }
+        }
+
+        let open_connections = |routers: &[Router]| -> Vec<u64> {
+            routers
+                .iter()
+                .map(|router| {
+                    let metrics = &router.endpoint().metrics().socket;
+                    metrics.num_conns_opened.get() - metrics.num_conns_closed.get()
+                })
+                .collect()
+        };
+
+        // Churn: every node keeps re-joining every other node on every topic.
+        for _ in 0..30 {
+            for (sender, others) in &senders {
+                let _ = timeout(Duration::from_secs(1), sender.join_peers(others.clone())).await;
+            }
+            tokio::time::sleep(Duration::from_millis(500)).await;
+        }
+
+        // Let the swarm settle; unused connections must be closed after a short grace period.
+        tokio::time::sleep(Duration::from_secs(15)).await;
+        let open = open_connections(&routers);
+        // Two peers that dial each other at the same time each keep the connection the other uses.
+        let limit = 2 * (NODES as u64 - 1);
+        assert!(
+            open.iter().all(|count| *count <= limit),
+            "unused gossip connections were not closed: {open:?} (limit {limit})"
+        );
+
+        for router in routers {
+            router.shutdown().await.std_context("shutdown router")?;
+        }
         Ok(())
     }
