+    /// Drops peers that no topic uses and that we did not send to for [`UNUSED_GRACE`].
+    ///
+    /// The protocol state only asks to disconnect peers it received a message from, so
+    /// a peer we only sent to (a join, a shuffle reply) would keep its connection forever.
+    /// Dropping the peer ends our sends, and the connection loop then closes the connection.
+    fn drop_unused_peers(&mut self, now: Instant) {
