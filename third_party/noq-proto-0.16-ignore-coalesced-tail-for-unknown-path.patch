+
+/// A datagram that carries more than one QUIC packet can reach a connection with a path id
+/// the connection does not have. The first packet is rejected and the rest must be dropped
+/// as well instead of panicking.
+#[test]
+fn coalesced_datagram_for_never_opened_path_is_ignored() {
+    let _guard = subscribe();
+    let mut cfg = TransportConfig::default();
+    cfg.max_concurrent_multipath_paths(MAX_PATHS);
+    cfg.initial_rtt(Duration::from_millis(10));
+    let server_cfg = ServerConfig {
+        transport: Arc::new(cfg.clone()),
+        ..server_config()
+    };
+    let client_cfg = ClientConfig {
+        transport: Arc::new(cfg),
+        ..client_config()
+    };
+    let mut pair = Pair::new(Default::default(), server_cfg);
+    let client_ch = pair.begin_connect(client_cfg);
+    pair.drive_client();
+    pair.drive_server();
+
+    // The server's first flight coalesces its Initial and Handshake packets.
+    let cid_parser =
+        FixedLengthConnectionIdParser::new(RandomConnectionIdGenerator::default().cid_len());
+    let grease_quic_bit = pair.client.endpoint.config().grease_quic_bit;
+    let (first_decode, remaining, ecn, remote, dst_ip) = pair
+        .client
+        .inbound
+        .iter()
+        .find_map(|inbound| {
+            let (first_decode, remaining) = PartialDecode::new(
+                inbound.packet.clone(),
+                &cid_parser,
+                DEFAULT_SUPPORTED_VERSIONS,
+                grease_quic_bit,
+            )
+            .ok()?;
+            remaining.is_some().then_some((
+                first_decode,
+                remaining,
+                inbound.ecn,
+                inbound.remote,
+                inbound.dst_ip,
+            ))
+        })
+        .expect("server should have queued a coalesced handshake datagram for client");
+
+    pair.drive();
+    pair.server.assert_accept();
+
+    let never_opened = PathId::from(7u32);
+    let now = pair.time;
+    let client = pair.client.connections.get_mut(&client_ch).unwrap();
+    assert!(
+        !client.paths().contains(&never_opened),
+        "path 7 must not exist"
+    );
+    client.handle_event(ConnectionEvent(ConnectionEventInner::Datagram(
+        DatagramConnectionEvent {
+            now,
+            network_path: FourTuple {
+                remote,
+                local_ip: dst_ip,
+            },
+            path_id: never_opened,
+            ecn,
+            first_decode,
+            remaining,
+        },
+    )));
 }
